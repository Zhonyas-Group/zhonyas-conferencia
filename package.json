{
  "name": "zhonyas-conferencia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Presentación de Zhonyas para conferencia: motor propio, funciona sin internet y desde un USB.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:prueba": "vite --mode prueba",
    "lab": "vite --open /lab.html",
    "lab:compilar": "vite build --mode lab",
    "lab:cuadros": "node scripts/lab-cuadros.mjs",
    "tipos": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "compilar:prueba": "vite build --mode prueba",
    "dev:muestra": "vite --mode muestra --port 5480",
    "compilar:muestra": "tsc --noEmit -p tsconfig.json && vite build --mode muestra",
    "servir": "node scripts/servir.mjs",
    "capturas": "npm run build && node scripts/capturas.mjs",
    "pdf": "npm run build && node scripts/pdf.mjs",
    "probar": "npm run build && npm run compilar:prueba && node scripts/probar.mjs && node scripts/probar-novedades.mjs && node scripts/probar-notas.mjs && node scripts/probar-auditor.mjs && node scripts/auditar.mjs",
    "auditar": "node scripts/auditar.mjs",
    "auditar:probar": "node scripts/probar-auditor.mjs",
    "probar:notas": "node scripts/probar-notas.mjs",
    "medio-prueba": "node scripts/generar-medio-prueba.mjs",
    "qr": "node scripts/generar-qr.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "motion": "^12.43.0",
    "ogl": "^1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsqr": "1.4.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.56.1",
    "qrcode": "1.5.4",
    "typescript": "5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
